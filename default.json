{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":separateMultipleMajorReleases"
  ],
  "schedule": [
    "at any time"
  ],
  "automerge": false,
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": false,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "Bypasses 'schedule' and 'minimumReleaseAge' by default, so a CVE fix isn't held back",
    "labels": [
      "dependencies",
      "renovate",
      "security"
    ]
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:monthly"
    ]
  },
  "pre-commit": {
    "enabled": true
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[\\w.-]*\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "config:recommended maps depType 'dependencies' to 'fix', which publishes a release. Reset to 'chore'; publishing repos re-enable 'fix' explicitly for their own runtime deps.",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Bundle minor/patch bumps into one PR, automerge after CI. Placed before the build-tooling/test-dep rules so those keep their own group names.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Bundle majors into one PR too. Automerge relies on platformAutomerge, so a repo requiring PR approval still waits on a human before merging.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "major dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Build tooling never reaches users, so its updates never trigger a release",
      "matchManagers": [
        "github-actions",
        "gradle-wrapper",
        "maven-wrapper",
        "sbt"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "build tooling",
      "semanticCommitType": "chore"
    },
    {
      "description": "Digest/pin bumps are hash-only, not new code -- safe to merge unattended for any repo",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchDepTypes": [
        "plugin"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "build tooling",
      "semanticCommitType": "chore"
    },
    {
      "description": "Test-only deps aren't part of any published artifact",
      "matchDepTypes": [
        "test",
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "build and test dependencies",
      "semanticCommitType": "chore"
    },
    {
      "description": "First-party ZirekHQ artifacts carry no third-party supply-chain risk -- skip the release-age wait and group for one combined review.",
      "matchSourceUrls": [
        "https://github.com/ZirekHQ/**"
      ],
      "minimumReleaseAge": "0 days",
      "groupName": "ZirekHQ artifacts"
    },
    {
      "description": "Automerge first-party patch/minor bumps once CI passes -- the org controls both ends, so review overhead outweighs the risk. Majors still need a manual look.",
      "matchSourceUrls": [
        "https://github.com/ZirekHQ/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Docker tags for the zizmor image carry no release timestamp, so minimumReleaseAge would hold every bump as pending forever.",
      "matchPackageNames": [
        "ghcr.io/zizmorcore/zizmor"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
