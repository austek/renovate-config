{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration"
  ],
  "schedule": [
    "at any time"
  ],
  "automerge": false,
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": false,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "Bypasses 'schedule' and 'minimumReleaseAge' by default, so a CVE fix isn't held back",
    "labels": [
      "dependencies",
      "renovate",
      "security"
    ]
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:monthly"
    ],
    "automerge": true,
    "automergeType": "pr"
  },
  "pre-commit": {
    "enabled": true
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[\\w.-]*\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "config:recommended maps depType 'dependencies' to 'fix', which publishes a release. Reset to 'chore'; publishing repos re-enable 'fix' explicitly for their own runtime deps.",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Patches group apart from minors so one breaking minor can't block them. Placed before the build-tooling/test-dep rules so those keep their own group names.",
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "patch dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Placed before the build-tooling/test-dep rules so those keep their own group names.",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "minor dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Bundle majors into one PR.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "major dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Build tooling never reaches users; grouped apart from runtime dependencies.",
      "matchManagers": [
        "github-actions",
        "gradle-wrapper",
        "maven-wrapper",
        "sbt"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "build tooling"
    },
    {
      "description": "Digest/pin bumps are hash-only, not new code -- safe to merge unattended for any repo",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Build plugins are grouped with build tooling.",
      "matchDepTypes": [
        "plugin"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "build tooling"
    },
    {
      "description": "Test-only deps aren't part of any published artifact",
      "matchDepTypes": [
        "test",
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "build and test dependencies"
    },
    {
      "description": "First-party ZirekHQ artifacts carry no third-party supply-chain risk -- skip the release-age wait and group into one PR.",
      "matchSourceUrls": [
        "https://github.com/ZirekHQ/**"
      ],
      "minimumReleaseAge": "0 days",
      "groupName": "ZirekHQ artifacts"
    },
    {
      "description": "Automerge every first-party bump once CI passes -- the org controls both ends, so review overhead outweighs the risk.",
      "matchSourceUrls": [
        "https://github.com/ZirekHQ/**"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Docker tags for the zizmor image carry no release timestamp, so minimumReleaseAge would hold every bump as pending forever.",
      "matchPackageNames": [
        "ghcr.io/zizmorcore/zizmor"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
