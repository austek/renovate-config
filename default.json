{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    "schedule:weekly"
  ],
  "automerge": false,
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": false,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "Bypasses 'schedule' and 'minimumReleaseAge' by default, so a CVE fix isn't held back",
    "labels": [
      "dependencies",
      "renovate",
      "security"
    ]
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr"
  },
  "pre-commit": {
    "enabled": true
  },
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[\\w.-]*\\.txt$/"
    ]
  },
  "packageRules": [
    {
      "description": "config:recommended maps depType 'dependencies' to 'fix', which publishes a release. Reset to 'chore'; publishing repos re-enable 'fix' explicitly for their own runtime deps.",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "One PR per cycle for every non-major update, build tooling and test deps included.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Bundle majors into one PR.",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "major dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "First-party artifacts (ZirekHQ, hominux, compress4j) carry no third-party supply-chain risk -- skip the release-age wait and group into one PR.",
      "matchSourceUrls": [
        "https://github.com/ZirekHQ/**",
        "https://github.com/hominux/**",
        "https://github.com/compress4j/**"
      ],
      "minimumReleaseAge": "0 days",
      "groupName": "first-party artifacts"
    },
    {
      "description": "Automerge every first-party bump once CI passes -- the org controls both ends, so review overhead outweighs the risk.",
      "matchSourceUrls": [
        "https://github.com/ZirekHQ/**",
        "https://github.com/hominux/**",
        "https://github.com/compress4j/**"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Docker tags for the zizmor image carry no release timestamp, so minimumReleaseAge would hold every bump as pending forever.",
      "matchPackageNames": [
        "ghcr.io/zizmorcore/zizmor"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "zizmor-action only accepts the zizmor versions bundled with its own release, and the image bumps with no release-age wait (rule above). Release the action without the wait and group both so one PR carries a matching pair.",
      "matchPackageNames": [
        "zizmorcore/zizmor-action",
        "ghcr.io/zizmorcore/zizmor"
      ],
      "minimumReleaseAge": "0 days",
      "groupName": "zizmor"
    }
  ]
}
